      "role": "user",
      "content": "What is stress?",
      "metadata": {},
      "created_at": "2026-10-27T17:17:56.806416+00:00"
    },
    {
      "id": "3655f044-db88-4359-9f76-dd89b874f1fd",
      "session_id": "f630742f-433f-458d-9d6a-dcd9ec3f8704",
      "turn_id": "4a342a6b-f159-4b8b-8a81-b462ffa16aef",
      "role": "assistant",
      "content": "Stress can be a mental or physical response to an outside demand, such as schoolwork. This is general information from NIMH, not an assessment of your experience. This prototype does not determine a cause, diagnose a condition or choose treatment.",
      "metadata": {
        "source": "mock",
        "reply_id": "stress",
        "evidence_ids": [
          "catalog:stress"
        ],
        "model_id": null,
        "prompt_version": "catalog-selector-v8",
