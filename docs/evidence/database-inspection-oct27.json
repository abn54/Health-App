      "session_id": "f630742f-433f-458d-9d6a-dcd9ec3f8704",
      "turn_id": "3dd2e417-8aeb-4f27-b92d-41ca74914717",
      "role": "user",
      "content": "Can you be my therapist?",
      "metadata": {},
