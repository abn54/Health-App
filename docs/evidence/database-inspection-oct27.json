      "turn_id": "2fce2e09-8672-4a9c-a867-fb1cd1fb3849",
      "role": "user",
      "content": "Do I have to watch a moving shape?",
      "metadata": {},
      "created_at": "2026-10-27T17:20:18.128978+00:00"
    },
    {
      "id": "37de94fa-941c-456f-8771-feee88bc6736",
      "session_id": "f7a2f911-4bc2-41bf-a4b0-d598dd6de467",
      "turn_id": "2fce2e09-8672-4a9c-a867-fb1cd1fb3849",
      "role": "assistant",
      "content": "Inhale uses a muted green circle; exhale uses muted blue. The phase word and count carry the same information, so color is never required. Choose Text only before or during the exercise to remove the moving shape. Changing the cue preserves your place and does not save a preference.",
      "metadata": {
        "source": "live",
        "reply_id": "motion",
        "evidence_ids": [
          "catalog:motion"
        ],
        "model_id": "qwen2.5:3b",
