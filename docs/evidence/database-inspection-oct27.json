      "role": "assistant",
      "content": "I am an educational assistant for this fictional coursework prototype, not a therapist. I can explain reviewed app content and general stress information. I cannot diagnose, provide treatment, or monitor anyone. Use fictional questions only.",
      "metadata": {
        "source": "mock",
        "reply_id": "scope",
